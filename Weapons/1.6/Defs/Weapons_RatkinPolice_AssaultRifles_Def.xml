<Defs>
  <ThingDef ParentName="BaseMakeableGun">
    <defName>RatkinPolice_QBZ95</defName>
    <label>特警｜95突击步枪</label>
    <description>鼠民特勤单位使用的5.8×42mm无托突击步枪，结构紧凑，适合巡逻增援与中距离交火。</description>
    <graphicData>
      <texPath>Things/Weapon/特警｜95突击步枪/特警｜95突击步枪</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.35</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>1200</WorkToMake>
      <Mass>3.25</Mass>
      <AccuracyTouch>0.62</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.66</AccuracyMedium>
      <AccuracyLong>0.50</AccuracyLong>
      <RangedWeapon_Cooldown>0.24</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Chemfuel>5</Chemfuel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>RatkinPolice_Bullet_58x42_QBZ95</defaultProjectile>
        <warmupTime>0.80</warmupTime>
        <range>60</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <soundCast>Shot_AssaultRifle</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponTags>
      <li>Gun</li>
      <li>Rifle</li>
      <li>RatkinPolice_Rifle</li>
      <li>RatkinPolice_PoliceWeapon</li>
    </weaponTags>
    <thingCategories Inherit="True">
      <li>RatkinPolice_PoliceWeapons</li>
    </thingCategories>
  </ThingDef>
