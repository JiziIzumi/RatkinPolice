<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BaseMakeableGun">
    <defName>RatkinPolice_CSLR4SniperRifle</defName>
    <label>特警｜CS/LR4狙击步枪</label>
    <description>面向远距离精确处置的高威力狙击步枪，适合特勤警戒与高风险目标控制。</description>
    <graphicData>
      <texPath>Things/Weapon/特警｜CS-LR4狙击步枪/特警｜CS-LR4狙击步枪</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.35</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>1200</WorkToMake>
      <Mass>6.50</Mass>
      <AccuracyTouch>0.58</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.84</AccuracyMedium>
      <AccuracyLong>0.88</AccuracyLong>
      <RangedWeapon_Cooldown>2.80</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>75</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Chemfuel>5</Chemfuel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>RatkinPolice_Bullet_308Win_CSLR4</defaultProjectile>
        <warmupTime>2.20</warmupTime>
        <range>160</range>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
        <soundCast>Shot_SniperRifle</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponTags>
      <li>Gun</li>
      <li>SniperRifle</li>
      <li>RatkinPolice_SniperRifle</li>
      <li>RatkinPolice_PoliceWeapon</li>
    </weaponTags>
    <thingCategories Inherit="True">
      <li>RatkinPolice_PoliceWeapons</li>
    </thingCategories>
  </ThingDef>
