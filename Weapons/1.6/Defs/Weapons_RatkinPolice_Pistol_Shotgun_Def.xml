<Defs>
  <ThingDef ParentName="BaseMakeableGun">
    <defName>RatkinPolice_Type972Shotgun</defName>
    <label>特警｜97-2霰弹枪</label>
    <description>面向近距离警务处置的12号口径泵动霰弹枪，适合室内和狭窄区域使用。</description>
    <graphicData>
      <texPath>Things/Weapon/特警｜97-2霰弹枪/特警｜97-2霰弹枪</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.35</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>1200</WorkToMake>
      <Mass>3.18</Mass>
      <AccuracyTouch>0.8</AccuracyTouch>
      <AccuracyShort>0.64</AccuracyShort>
      <AccuracyMedium>0.32</AccuracyMedium>
      <AccuracyLong>0.15</AccuracyLong>
      <RangedWeapon_Cooldown>1.20</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Chemfuel>5</Chemfuel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>RatkinPolice_Bullet_12Gauge</defaultProjectile>
        <warmupTime>0.90</warmupTime>
        <range>20</range>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>1</ticksBetweenBurstShots>
        <soundCast>Shot_PumpShotgun</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponTags>
      <li>Gun</li>
      <li>Shotgun</li>
      <li>RatkinPolice_Shotgun</li>
      <li>RatkinPolice_PoliceWeapon</li>
    </weaponTags>
    <thingCategories Inherit="True">
      <li>RatkinPolice_PoliceWeapons</li>
    </thingCategories>
  </ThingDef>
