    <label>特警｜79式冲锋枪</label>
    <description>鼠民警务体系长期使用的轻型冲锋枪，以高射速和近距离压制能力见长。</description>
    <graphicData>
      <texPath>Things/Weapon/特警｜79式冲锋枪/特警｜79式冲锋枪</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.10</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>1200</WorkToMake>
      <Mass>1.75</Mass>
      <AccuracyTouch>0.55</AccuracyTouch>
      <AccuracyShort>0.64</AccuracyShort>
      <AccuracyMedium>0.45</AccuracyMedium>
      <AccuracyLong>0.3</AccuracyLong>
      <RangedWeapon_Cooldown>0.25</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>45</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Chemfuel>5</Chemfuel>
    </costList>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>RatkinPolice_Bullet_SMG_81Power</defaultProjectile>
        <warmupTime>0.75</warmupTime>
        <range>44</range>
        <burstShotCount>5</burstShotCount>
        <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
        <soundCast>Shot_HeavySMG</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <weaponTags>
      <li>Gun</li>
      <li>SMG</li>
      <li>RatkinPolice_SMG</li>
      <li>RatkinPolice_PoliceWeapon</li>
    </weaponTags>
    <thingCategories Inherit="True">
      <li>RatkinPolice_PoliceWeapons</li>
    </thingCategories>
